
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RecoverX</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <!-- Sign-in screen -->
  <section id="authPage" class="auth-page">
    <div class="auth-card">
      <div class="logo">RX</div>
      <h1>Recover<span>X</span></h1>
      <p class="muted">Your sports recovery companion</p>

      <div class="auth-tabs">
        <button id="signInTab" class="active">Sign in</button>
        <button id="signUpTab">Create account</button>
      </div>

      <form id="authForm">
        <label for="nameInput" id="nameLabel" hidden>Name</label>
        <input id="nameInput" type="text" placeholder="Your name" autocomplete="name" hidden>

        <label for="emailInput">Email</label>
        <input id="emailInput" type="email" placeholder="you@example.com"
          autocomplete="email" required>

        <label for="passwordInput">Password</label>
        <input id="passwordInput" type="password" placeholder="Demo password"
          autocomplete="current-password" required minlength="4">

        <button class="primary-btn full" type="submit" id="authSubmit">
          Sign in
        </button>
      </form>

      <p id="authMessage" class="message"></p>
      <p class="small muted">
        Prototype only: accounts are stored locally in this browser.
        Do not use a real password or sensitive medical information.
      </p>
    </div>
  </section>

  <!-- Main app -->
  <div id="app" hidden>
    <header class="topbar">
      <a class="brand" href="#" data-page="home">
        <span class="logo small-logo">RX</span>
        Recover<span class="accent">X</span>
      </a>

      <nav>
        <button class="nav-btn active" data-page="home">Home</button>
        <button class="nav-btn" data-page="plans">Injury plans</button>
        <button class="nav-btn" data-page="account">My account</button>
      </nav>

      <button id="themeToggle" class="theme-toggle">🌙</button>
    </header>

    <main>
      <!-- Home -->
      <section id="home" class="page active">
        <div class="hero">
          <p class="eyebrow">ATHLETE RECOVERY CENTER</p>
          <h1>Recover stronger.<br><span>Return smarter.</span></h1>
          <p>Explore injury education and organize your recovery information
            in one place.</p>
          <button class="primary-btn" data-page="plans">Explore injury plans →</button>
        </div>

        <div class="welcome-row">
          <div>
            <p class="eyebrow">YOUR RECOVERY SPACE</p>
            <h2 id="welcomeTitle">Welcome back!</h2>
            <p class="muted">Choose an injury to explore its information and plan.</p>
          </div>
        </div>

        <div class="injury-grid">
          <article class="injury-card">
            <span class="card-tag">KNEE</span>
            <h3>ACL</h3>
            <p>Anterior Cruciate Ligament</p>
            <button class="text-btn" data-injury="ACL">Open ACL plan →</button>
          </article>

          <article class="injury-card">
            <span class="card-tag">KNEE</span>
            <h3>MCL</h3>
            <p>Medial Collateral Ligament</p>
            <button class="text-btn" data-injury="MCL">Open MCL plan →</button>
          </article>

          <article class="injury-card">
            <span class="card-tag">ANKLE</span>
            <h3>Achilles</h3>
            <p>Achilles tendon</p>
            <button class="text-btn" data-injury="Achilles">Open Achilles plan →</button>
          </article>
        </div>

        <div class="notice">
          <strong>Important</strong>
          <p>RecoverX is an educational project, not a medical service.
            Have a qualified healthcare professional guide your rehabilitation.
            Injury plans are not personalized prescriptions.</p>
        </div>
      </section>

      <!-- Injury plans -->
      <section id="plans" class="page">
        <div class="page-heading">
          <p class="eyebrow">REHABILITATION LIBRARY</p>
          <h1>Injury plans</h1>
          <p>Select an injury to view or edit its information.</p>
        </div>

        <div class="plan-tabs">
          <button class="plan-tab active" data-injury="ACL">ACL</button>
          <button class="plan-tab" data-injury="MCL">MCL</button>
          <button class="plan-tab" data-injury="Achilles">Achilles</button>
        </div>

        <article class="plan-card">
          <div class="plan-heading">
            <div>
              <span class="card-tag" id="planLocation">KNEE</span>
              <h2 id="planTitle">ACL</h2>
              <p id="planSubtitle" class="muted"></p>
            </div>
            <button id="resetPlan" class="secondary-btn">Reset information</button>
          </div>

          <div class="notice">
            <strong>Safety reminder</strong>
            <p>Use these sections to organize educational information.
              A clinician should determine exercises, loading, and return-to-sport readiness.</p>
          </div>

          <form id="planForm" class="plan-form">
            <label for="overview">What is the injury?</label>
            <textarea id="overview" rows="4"></textarea>

            <label for="causes">How can it happen?</label>
            <textarea id="causes" rows="4"></textarea>

            <label for="stagesInfo">Recovery stages and considerations</label>
            <textarea id="stagesInfo" rows="5"></textarea>

            <label for="exerciseInfo">Exercise information</label>
            <textarea id="exerciseInfo" rows="5"></textarea>

            <label for="personalNotes">My notes / research</label>
            <textarea id="personalNotes" rows="5"
              placeholder="Add your own research, sources, or notes here..."></textarea>

            <button class="primary-btn" type="submit">Save injury information</button>
            <p id="saveMessage" class="message"></p>
          </form>
        </article>
      </section>

      <!-- Account -->
      <section id="account" class="page">
        <div class="page-heading">
          <p class="eyebrow">YOUR PROFILE</p>
          <h1>My account</h1>
        </div>

        <div class="account-card">
          <div class="logo">RX</div>
          <h2 id="accountName">User</h2>
          <p id="accountEmail" class="muted"></p>
          <p class="small muted">Demo account stored in this browser.</p>
          <button id="signOut" class="secondary-btn">Sign out</button>
        </div>
      </section>
    </main>

    <footer>
      <span>RecoverX</span>
      <span>Educational project • Not a medical device</span>
    </footer>
  </div>

  <script src="script.js"></script>
</body>
</html>
